# TinyFish search/fetch API keys (https://api.tinyfish.ai) — up to 5 keys, rotated on rate limits.
# TINYFISH_API_KEY is the name in TinyFish's own docs and is also read.
TINYFISH_API_KEY=
TINYFISH_KEY=
TINYFISH_KEY_1=
TINYFISH_KEY_2=
TINYFISH_KEY_3=
TINYFISH_KEY_4=
TINYFISH_KEY_5=

# Kilo Gateway keys (https://api.kilo.ai) — KILO_API_KEY is the name in Kilo's own
# docs and is also read. A leading "Bearer " is stripped automatically.
KILO_API_KEY=
KILO_GATEWAY_KEY_1=
KILO_GATEWAY_KEY_2=
KILO_GATEWAY_KEY_3=
KILO_GATEWAY_KEY_4=
KILO_GATEWAY_KEY_5=
# KILO_GATEWAY_KEY=

# Optional shared cache. Without these, an in-memory per-instance cache is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=
# REDIS_TOKEN=

# Optional overrides for the deterministic analytics constants.
# FUEL_BASE_DIESEL_PRICE=3.42
# FUEL_FACTOR=0.08
# GRID_LOSS_FACTOR=1.08
# WATER_SCARCITY_MULTIPLIER=1.35
