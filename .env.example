# Playwright MCP server URL (always-on, primary web search provider)
# Local dev: http://localhost:8931/mcp (start with: npx @playwright/mcp@latest --port 8931 --host 0.0.0.0 --headless --shared-browser-context)
# Cloud/Vercel (no localhost MCP): set to a reachable remote MCP URL (e.g. https://your-mcp-host/mcp), or leave empty/unset to disable MCP probing and use DuckDuckGo fallback only.
# If unset, the app defaults to localhost locally but disables MCP in Vercel/cloud to avoid probing unreachable localhost.
PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp

# DuckDuckGo HTTP search (fallback, no API key required — used automatically when MCP is unavailable/fails)
# DUCKDUCKGO_ENABLED=true (informational only)

# Kilo Gateway keys (https://api.kilo.ai) — the bare name works too.
KILO_GATEWAY_KEY_1=
KILO_GATEWAY_KEY_2=
KILO_GATEWAY_KEY_3=
KILO_GATEWAY_KEY_4=
KILO_GATEWAY_KEY_5=
# KILO_GATEWAY_KEY=

# Optional shared cache. Without these, an in-memory per-instance cache is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=
# REDIS_TOKEN=

# Optional overrides for the deterministic analytics constants.
# FUEL_BASE_DIESEL_PRICE=3.42
# FUEL_FACTOR=0.08
# GRID_LOSS_FACTOR=1.08
# WATER_SCARCITY_MULTIPLIER=1.35

# Optional: Vercel Analytics. Enable server-side tracking and Web Analytics on Vercel.
# VERCEL_WEB_ANALYTICS_ENDPOINT=
