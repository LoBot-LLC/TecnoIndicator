# Web search — embedded SearXNG MCP server (primary web search provider)
# When SEARXNG_MCP_URL is unset, the app embeds its own Streamable HTTP MCP
# server at /api/mcp (see app/api/mcp/route.ts). That endpoint proxies to a
# SearXNG instance (SEARXNG_INSTANCE_URL) and falls back to DuckDuckGo HTTP
# search internally when the instance is unavailable.
#
# Optional: point at an external MCP server instead of the embedded one.
# Local daemon via mcp/searxng-mcp-server.mjs: http://localhost:3000/mcp
#   (start with: SEARXNG_URL=http://localhost:8080 npm run searxng:mcp)
# Remote/cloud: set to a reachable mcp-searxng Streamable HTTP endpoint.
# Leave unset (or empty) to use the built-in /api/mcp server.
SEARXNG_MCP_URL=

# SearXNG instance used by the embedded MCP server at /api/mcp.
# URL of a SearXNG instance with JSON format enabled, e.g. http://localhost:8080
# If unset, the embedded MCP server falls back to DuckDuckGo HTTP search.
SEARXNG_INSTANCE_URL=

# Playwright MCP server URL (optional, legacy browser automation)
# Local dev: http://localhost:8931/mcp (start with: npx @playwright/mcp@latest --port 8931 --host 0.0.0.0 --headless --shared-browser-context)
# Cloud/Vercel (no localhost MCP): set to a reachable remote MCP URL, or leave empty/unset to disable MCP probing.
# If unset, the app defaults to localhost locally but disables MCP in Vercel/cloud.
# NOTE: The primary web search provider is SearXNG MCP (SEARXNG_MCP_URL).
PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp

# DuckDuckGo HTTP search (fallback, no API key required — used automatically ONLY when SearXNG MCP is unavailable/fails)
# DUCKDUCKGO_ENABLED=true (informational only)

# Kilo Gateway keys (https://api.kilo.ai) — the bare name works too.
KILO_GATEWAY_KEY_1=
KILO_GATEWAY_KEY_2=
KILO_GATEWAY_KEY_3=
KILO_GATEWAY_KEY_4=
KILO_GATEWAY_KEY_5=
# KILO_GATEWAY_KEY=

# Optional shared cache. Without these, an in-memory per-instance cache is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=
# REDIS_TOKEN=

# Optional overrides for the deterministic analytics constants.
# FUEL_BASE_DIESEL_PRICE=3.42
# FUEL_FACTOR=0.08
# GRID_LOSS_FACTOR=1.08
# WATER_SCARCITY_MULTIPLIER=1.35

# Optional: Vercel Analytics. Enable server-side tracking and Web Analytics on Vercel.
# VERCEL_WEB_ANALYTICS_ENDPOINT=